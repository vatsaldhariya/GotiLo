<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.gotilo.simtool">

    <!-- ======================================================= -->
    <!-- 1. MANDATORY PERMISSIONS (Must be ABOVE application tag)  -->
    <!-- ======================================================= -->

    <!-- Network -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <!-- Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Hardware Media -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Android 14+ Foreground Service Permissions (ALL THREE REQUIRED) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- ADDED THIS BACK: Required for the audio recording FGS -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- System Utilities & Background Bypasses -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />


    <!-- ======================================================= -->
    <!-- 2. APPLICATION SETTINGS & SCREENS                       -->
    <!-- ======================================================= -->
    <application
        android:allowBackup="true"
        android:name="gotilo"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gotilo"
        android:usesCleartextTraffic="true"
        tools:ignore="ForegroundServicePermission">

        <!-- Screen 1: Register Activity (Launcher) -->
        <activity
            android:name="com.gotilo.simtool.screen.PermissionActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Login Activity -->
        <activity
            android:name="com.gotilo.simtool.screen.LoginActivity"
            android:exported="false" />

        <!-- Screen 3: Dashboard Activity -->
        <activity
            android:name="com.gotilo.simtool.screen.DashboardActivity"
            android:exported="false" />

        <!-- Screen 4: Permission Onboarding Activity -->
        <activity
            android:name="com.gotilo.simtool.screen.KioskActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />

        <!-- Boot & Shutdown Receiver -->
        <receiver
            android:name="com.gotilo.simtool.utils.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <!-- 👇 ADDED THE MISSING BOOT COMMANDS 👇 -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />

                <!-- Keeps your shutdown commands -->
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
                <action android:name="android.intent.action.QUICKBOOT_POWEROFF" />
            </intent-filter>
        </receiver>

        <!-- SIM Card Change Receiver -->
        <receiver
            android:name="com.gotilo.simtool.utils.SimChangeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SIM_STATE_CHANGED" />
                <action android:name="android.telephony.action.SIM_CARD_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Firebase Messaging Service -->
        <service
            android:name="com.gotilo.simtool.service.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- FIXED: Reverted back to the Transparent theme -->
        <activity
            android:name="com.gotilo.simtool.screen.TransparentActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <activity
            android:name="com.gotilo.simtool.screen.AppSelectionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Location Foreground Service -->
        <service
            android:name="com.gotilo.simtool.service.LiveTrackingService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Media Foreground Service (Camera & Mic) -->
        <service
            android:name="com.gotilo.simtool.service.MediaCaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <service
            android:name="com.gotilo.simtool.service.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name="com.gotilo.simtool.service.YourAccessibilityService"
            android:exported="true"
            android:label="Gotilo App Locker"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_blocker_config" />
        </service>

        <receiver
            android:name="com.gotilo.simtool.service.MyAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.gotilo.simtool.utils.SmsCommandReceiver"
            android:permission="android.permission.BROADCAST_SMS"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>