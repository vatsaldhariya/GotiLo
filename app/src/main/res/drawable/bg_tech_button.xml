<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed: slightly deeper / compressed gradient -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#7C3AED"
                android:endColor="#0EA5E9" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#8B5CF6"
                android:endColor="#38BDF8" />
        </shape>
    </item>

</selector>