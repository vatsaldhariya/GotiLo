<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base deep navy backdrop -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#070A13" />
        </shape>
    </item>

    <!-- Soft violet glow, upper right -->
    <item android:gravity="top|end" android:width="420dp" android:height="420dp"
        android:top="-140dp" android:end="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:centerColor="#268B5CF6"
                android:endColor="#00070A13" />
        </shape>
    </item>

    <!-- Soft cyan-blue glow, lower left -->
    <item android:gravity="bottom|start" android:width="380dp" android:height="380dp"
        android:bottom="-120dp" android:start="-140dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="190dp"
                android:centerColor="#1A38BDF8"
                android:endColor="#00070A13" />
        </shape>
    </item>

</layer-list>