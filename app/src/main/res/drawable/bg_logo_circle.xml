<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#0F1424" />
            <stroke android:width="1dp" android:color="#332E3550" />
        </shape>
    </item>

    <item android:width="30dp" android:height="30dp" android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#8B5CF6"
                android:endColor="#38BDF8" />
        </shape>
    </item>

</layer-list>