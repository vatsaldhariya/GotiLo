<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for all standard Activities -->
    <style name="Base.Theme.Gotilo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Standard full-screen settings -->
        <item name="android:windowBackground">#090D17</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <style name="Theme.Gotilo" parent="Base.Theme.Gotilo" />

    <!-- Use this ONLY for popups/overlays in AndroidManifest.xml if specifically needed -->
    <style name="Theme.Gotilo.DialogOverlay" parent="Base.Theme.Gotilo">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>