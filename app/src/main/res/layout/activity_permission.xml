<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient_glow"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="40dp">

        <!-- Eyebrow label -->
        <TextView
            android:id="@+id/tvEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="REQUIRED ACCESS"
            android:textColor="#8B5CF6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Header -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Security Setup."
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEyebrow" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Gotilo needs background permissions to secure your device and provide live tracking."
            android:textColor="#8B9BB4"
            android:textSize="14.5sp"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Permissions Container -->
        <LinearLayout
            android:id="@+id/permissionsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <!-- Permission Card 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Camera, Mic &amp; Location"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Allows capturing security photos and getting location coordinates."
                    android:textColor="#8B9BB4"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStandardPerms"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Grant Permissions"
                    android:textColor="#8B5CF6"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    app:backgroundTint="#090D17"
                    app:cornerRadius="12dp"
                    app:strokeColor="#8B5CF6"
                    app:strokeWidth="1dp"
                    app:rippleColor="#338B5CF6" />
            </LinearLayout>

            <!-- Permission Card 2: SMS Commands -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. SMS Recovery Commands"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Allows processing offline SMS triggers to play alarms and reply with location coordinates."
                    android:textColor="#8B9BB4"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSmsPerms"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Grant SMS Permissions"
                    android:textColor="#8B5CF6"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    app:backgroundTint="#090D17"
                    app:cornerRadius="12dp"
                    app:strokeColor="#8B5CF6"
                    app:strokeWidth="1dp"
                    app:rippleColor="#338B5CF6" />
            </LinearLayout>

            <!-- Permission Card 3: Overlay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Display Over Other Apps"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Enables background hardware activation when the phone is locked."
                    android:textColor="#8B9BB4"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlayPerm"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Enable Overlay"
                    android:textColor="#8B5CF6"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    app:backgroundTint="#090D17"
                    app:cornerRadius="12dp"
                    app:strokeColor="#8B5CF6"
                    app:strokeWidth="1dp"
                    app:rippleColor="#338B5CF6" />
            </LinearLayout>

            <!-- Permission Card 4: Battery -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Disable Battery Saver"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Prevents Android from killing background tracking threads."
                    android:textColor="#8B9BB4"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatteryPerm"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Disable Battery Saver"
                    android:textColor="#8B5CF6"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    app:backgroundTint="#090D17"
                    app:cornerRadius="12dp"
                    app:strokeColor="#8B5CF6"
                    app:strokeWidth="1dp"
                    app:rippleColor="#338B5CF6" />
            </LinearLayout>

            <!-- Permission Card 5: App Locker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5. App Locker (Accessibility)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Required to instantly block and auto-exit from unauthorized apps."
                    android:textColor="#8B9BB4"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAppLockerPerm"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Enable App Locker"
                    android:textColor="#8B5CF6"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    app:backgroundTint="#090D17"
                    app:cornerRadius="12dp"
                    app:strokeColor="#8B5CF6"
                    app:strokeWidth="1dp"
                    app:rippleColor="#338B5CF6" />
            </LinearLayout>

            <!-- 🌟 NEW: App Selection Card -->
            <LinearLayout
                android:id="@+id/cardAppSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ Select Apps to Block"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Choose which applications Gotilo should restrict access to."
                    android:textColor="#8B9BB4"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectApps"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Choose Apps Now"
                    android:textColor="#8B5CF6"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    app:backgroundTint="#090D17"
                    app:cornerRadius="12dp"
                    app:strokeColor="#8B5CF6"
                    app:strokeWidth="1dp"
                    app:rippleColor="#338B5CF6" />
            </LinearLayout>

            <!-- Permission Card 6: Device Admin -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6. Device Admin (Security)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Required to enforce instant screen locking when unauthorized touch shields are breached."
                    android:textColor="#8B9BB4"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeviceAdminPerm"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Enable Device Admin"
                    android:textColor="#8B5CF6"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    app:backgroundTint="#090D17"
                    app:cornerRadius="12dp"
                    app:strokeColor="#8B5CF6"
                    app:strokeWidth="1dp"
                    app:rippleColor="#338B5CF6" />
            </LinearLayout>

        </LinearLayout>

        <!-- Gradient Action Button (Continue) -->
        <FrameLayout
            android:id="@+id/btnContinueWrapper"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/permissionsContainer">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_tech_button"
                android:elevation="6dp"
                android:letterSpacing="0.04"
                android:stateListAnimator="@null"
                android:text="Continue to App"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>