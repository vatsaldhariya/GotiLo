<?xml version="1.0" encoding="utf-8"?>
<!-- Root Layout handles the background and status bar/nav bar spacing -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient_glow"
    android:fitsSystemWindows="true">

    <!-- Inner Layout safely keeps your custom paddings intact -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp"
        android:paddingBottom="40dp">

        <!-- Eyebrow label -->
        <TextView
            android:id="@+id/tvEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="APP LOCKER"
            android:textColor="#8B5CF6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Header -->
        <TextView
            android:id="@+id/tvAppSelectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Select Apps."
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEyebrow" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvAppSelectionSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Choose the applications you want Gotilo to restrict access to."
            android:textColor="#8B9BB4"
            android:textSize="14.5sp"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppSelectionTitle" />

        <!-- Search Bar -->
        <EditText
            android:id="@+id/etSearchApp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card_glass"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppSelectionSub" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#8B5CF6"
            app:layout_constraintBottom_toBottomOf="@id/rvApps"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/rvApps" />

        <!-- RecyclerView (List of Apps) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:clipToPadding="false"
            app:layout_constraintBottom_toTopOf="@id/btnContinueWrapper"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etSearchApp" />

        <!-- Gradient Action Button Wrapper -->
        <FrameLayout
            android:id="@+id/btnContinueWrapper"
            android:layout_width="0dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_tech_button"
                android:elevation="6dp"
                android:letterSpacing="0.04"
                android:stateListAnimator="@null"
                android:text="Save Block List"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>